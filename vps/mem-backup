#!/usr/bin/env bash
# Run by mem-backup.service each night after dulali-backup: snapshots the mem
# store into the same restic repository, tagged mem, and keeps 30 dailies.
# dulali-backup's nightly prune frees what this forgets. A failed night sends
# /fail to the hub's healthchecks.io check, whose next ping marks it up again.
set -euo pipefail

store=${MEM_STORE:-/srv/mem/store}

alert() {
  local rc=$?
  ((rc)) || return 0
  [[ -n ${HUB_HC_PING_URL:-} ]] || return 0
  printf 'url = "%s/fail"\n' "$HUB_HC_PING_URL" |
    curl -fsS -m 10 --retry 3 -o /dev/null -K - --data-raw "mem-backup exited $rc" ||
    echo "mem-backup: could not send /fail to healthchecks.io" >&2
}
trap alert EXIT

restic backup --retry-lock 2h --tag mem "$store"
restic forget --retry-lock 2h --tag mem --keep-daily 30
echo "mem-backup: done" >&2
