#!/usr/bin/env bash
# Prints a link that pairs a phone, a laptop or a device agent with the one
# hub on the VPS, and waits up to 10 minutes for it to be opened. A device
# agent pairs with `workflow agent pair <link>`.
set -euo pipefail

host=${VPS_HOST:-root@dulali}
exec ssh -t "$host" runuser -u mem -- env HOME=/var/lib/mem \
  XDG_CONFIG_HOME=/var/lib/mem/.config XDG_STATE_HOME=/var/lib/mem/.local/state \
  XDG_DATA_HOME=/srv hub pair
