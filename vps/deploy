#!/usr/bin/env bash
# Builds mem, workflow and hub on the VPS from one commit of this repository,
# then restarts the hub there. Run it from a checkout on a device:
#
#   vps/deploy [<commit>]        HEAD when no commit is given
#
# The VPS has no git, so the commit travels as a git archive over ssh, and
# HUB_COMMIT carries its name into `hub --version`.
set -euo pipefail

host=${VPS_HOST:-root@dulali}
commit=$(git rev-parse --verify "${1:-HEAD}^{commit}")
short=$(git rev-parse --short=7 "$commit")
src=/var/lib/workflow-build/src

# Read before the VPS changes, so a missing secret stops the deploy whole.
secret=$(pass show dulali/hub-webhook-secret)
[[ -n $secret ]] || { echo "deploy: pass dulali/hub-webhook-secret is empty" >&2; exit 1; }
tunnel=$(pass show dulali/cloudflared-token)
[[ -n $tunnel ]] || { echo "deploy: pass dulali/cloudflared-token is empty" >&2; exit 1; }
# cargo zigbuild needs zig on PATH; the mini keeps it where the m1 spike put it.
command -v zig >/dev/null || PATH="$HOME/.cache/m1-spike/zig-aarch64-linux-0.14.1:$PATH"
command -v zig >/dev/null || { echo "deploy: no zig on PATH; cargo zigbuild needs it" >&2; exit 1; }

# Over stdin, never argv: the hub signs Hermes webhooks with it.
printf 'HUB_DULALI_SECRET=%s\n' "$secret" |
  ssh "$host" "umask 077 && install -d -m 0750 /etc/mem && cat > /etc/mem/dulali.env.new && mv -f /etc/mem/dulali.env.new /etc/mem/dulali.env"
printf '%s\n' "$tunnel" |
  ssh "$host" "umask 077 && cat > /etc/mem/cloudflared-token.new && mv -f /etc/mem/cloudflared-token.new /etc/mem/cloudflared-token"
git archive --format=tar "$commit" |
  ssh "$host" "rm -rf $src && mkdir -p $src && tar x -C $src"
# The mem and the local hub a cloud session runs, served at
# mem.on-rexa.com/dl/mem and /dl/hub: x86_64 and static, so they are built
# here (cargo zigbuild, zig on PATH), not on the VPS. The hub builds on
# hubpages and embeds the cloud prompt from workflow/, so both travel with
# them.
x86=$(mktemp -d)
trap 'rm -rf "$x86"' EXIT
git archive --format=tar "$commit" mem hub hubpages workflow/src/cloud-prompt.txt | tar x -C "$x86"
for crate in mem hub; do
  HUB_COMMIT=$short cargo zigbuild -q --release --target x86_64-unknown-linux-musl \
    --manifest-path "$x86/$crate/Cargo.toml" \
    --target-dir "${XDG_CACHE_HOME:-$HOME/.cache}/workflow/x86-target"
  ssh "$host" "install -d -m 0755 /var/lib/workflow-build && cat > /var/lib/workflow-build/$crate-x86_64.new" \
    <"${XDG_CACHE_HOME:-$HOME/.cache}/workflow/x86-target/x86_64-unknown-linux-musl/release/$crate"
done
ssh "$host" "bash $src/vps/install $short"
