[Unit]
Description=hub, the one hub every device and the phone use
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=mem
Group=mem
WorkingDirectory=/var/lib/mem
# mem's store is $XDG_DATA_HOME/mem/store, so this puts it at /srv/mem/store.
Environment=HOME=/var/lib/mem XDG_DATA_HOME=/srv XDG_CONFIG_HOME=/var/lib/mem/.config XDG_STATE_HOME=/var/lib/mem/.local/state
# The store is the sync point itself: a write here has nothing to push.
Environment=MEM_SYNC_CMD=true
Environment=TZ=Asia/Dhaka
ExecStart=/usr/local/bin/hub
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
