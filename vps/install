#!/usr/bin/env bash
# Runs on the VPS as root, from the source vps/deploy unpacked: builds the
# three binaries with 2 jobs, installs them and the units, and restarts the
# hub. Safe to run again: every step leaves what is already right alone.
set -euo pipefail

short=${1:?usage: install <short commit>}
build=/var/lib/workflow-build
src=$build/src
cargo=/root/.cargo/bin/cargo

if [[ ! -x $cargo ]]; then
  curl -sSf https://sh.rustup.rs | sh -s -- -y -q --profile minimal --default-toolchain stable
fi
if [[ ! -x /usr/bin/cloudflared ]]; then
  install -d -m 0755 /usr/share/keyrings
  curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg
  echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' \
    >/etc/apt/sources.list.d/cloudflared.list
  apt-get update -q && apt-get install -y -q cloudflared
fi
# The cloud's mem, built and sent by vps/deploy; the hub serves it.
if [[ -f $build/mem-x86_64.new ]]; then
  install -m 0755 "$build/mem-x86_64.new" /var/lib/mem/mem-x86_64
  rm -f "$build/mem-x86_64.new"
fi
for crate in mem workflow hub; do
  (cd "$src/$crate" && HUB_COMMIT=$short CARGO_TARGET_DIR=$build/target "$cargo" build --release -j2 -q)
  install -m755 "$build/target/release/$crate" "/usr/local/bin/$crate"
done

# The hub runs as mem and owns the store devices sync with as mem@dulali.
id mem >/dev/null 2>&1 || useradd --system --create-home --home-dir /var/lib/mem --shell /bin/bash mem
install -d -o mem -g mem -m 0750 /srv/mem /srv/mem/store
install -d -m 0750 /etc/mem
# Dulali's socket lives here, mounted into its workbench; a directory that
# outlives hub restarts, since each start makes the socket file anew.
install -d -o mem -g mem -m 0750 /var/lib/mem/dulali
# The hub never rewrites its config, so the Dulali keys are added once.
config=/var/lib/mem/.config/hub/config.toml
if [[ -f $config ]]; then
  grep -q '^dulali_webhook' "$config" ||
    echo 'dulali_webhook = "http://127.0.0.1:8644/webhooks/question"' >>"$config"
  grep -q '^dulali_socket' "$config" ||
    echo 'dulali_socket = "/var/lib/mem/dulali/hub.sock"' >>"$config"
  # cloudflared forwards Access's hostname as Host; the guard refuses
  # a dotted name outside .ts.net unless it is listed here.
  grep -q '^origins' "$config" ||
    echo 'origins = ["https://hub.on-rexa.com"]' >>"$config"
  # mem's connector: the port the tunnel sends mem.on-rexa.com to, and the
  # Access app whose tokens it takes.
  grep -q '^mcp_port' "$config" ||
    echo 'mcp_port = 8788' >>"$config"
  grep -q '^access_team' "$config" ||
    echo 'access_team = "https://saifulapm.cloudflareaccess.com"' >>"$config"
  grep -q '^mem_binary' "$config" ||
    echo 'mem_binary = "/var/lib/mem/mem-x86_64"' >>"$config"
  grep -q '^access_aud' "$config" ||
    echo 'access_aud = "4156a52d77bb948a63b9b6d4dad534cc230280e9cf4235f464a8761b35a9c998"' >>"$config"
fi

install -m644 "$src"/vps/units/* /etc/systemd/system/
install -m755 "$src/vps/mem-backup" /usr/local/sbin/mem-backup
systemctl daemon-reload
systemctl enable -q mem-hub.service mem-hub-ping.timer mem-backup.timer mem-tunnel.service
systemctl start mem-hub-ping.timer mem-backup.timer
systemctl restart mem-hub.service mem-tunnel.service

for _ in $(seq 20); do
  curl -fsS -o /dev/null http://127.0.0.1:8787/api/presence 2>/dev/null && break
  sleep 0.5
done
# On a tailnet where Serve was never enabled this waits on an admin page
# for ever, so it gets 20 s and says why when it gives up.
if ! out=$(timeout 20 tailscale serve --bg --https=443 http://127.0.0.1:8787 2>&1); then
  echo "install: tailscale serve failed: $out" >&2
  exit 1
fi
version=$(/usr/local/bin/hub --version)
[[ $version == *" $short" ]] || { echo "install: hub --version says '$version', not $short" >&2; exit 1; }
echo "install: $version serving on 443"
