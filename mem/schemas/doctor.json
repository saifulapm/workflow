{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem doctor --json",
  "description": "Findings for a human to read. Findings are exit 0; exit 3 means doctor could not run.",
  "type": "object",
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "finding",
        "description": "One health finding.",
        "type": "object",
        "required": [
          "check",
          "detail"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
