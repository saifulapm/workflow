{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem context --brief --json",
  "description": "The ≤480-byte brief, counted on the content string, empty when there is nothing to say, and where this checkout's project stands, worked out as its `mem projects --json` row is. Outside a project mem knows, `project` and the text keys are null, the counts zero and `paused` false.",
  "type": "object",
  "required": [
    "brief",
    "project",
    "roadmap_status",
    "milestone",
    "milestones_done",
    "milestones_total",
    "plan_slug",
    "plan_ticked",
    "plan_total",
    "runner",
    "paused",
    "questions_human"
  ],
  "properties": {
    "brief": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "roadmap_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ]
    },
    "milestones_done": {
      "type": "integer"
    },
    "milestones_total": {
      "type": "integer"
    },
    "plan_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_ticked": {
      "type": "integer"
    },
    "plan_total": {
      "type": "integer"
    },
    "runner": {
      "type": [
        "string",
        "null"
      ]
    },
    "paused": {
      "type": "boolean"
    },
    "questions_human": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
