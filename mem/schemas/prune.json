{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem prune --json",
  "description": "Stale candidates. Listing them changes nothing; exit 0 even when the list is empty.",
  "type": "object",
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "candidate",
        "description": "One item that could be archived, and why.",
        "type": "object",
        "required": [
          "id",
          "short_id",
          "kind",
          "title",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "short_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
