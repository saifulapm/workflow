{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem projects --json",
  "description": "Every project in the store, with this machine's current one marked.",
  "type": "object",
  "required": [
    "projects"
  ],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "project",
        "description": "One registered project, with the summary a project page reads: the roadmap status from project.toml, counts from roadmap.md and plan.md, which wiki pages exist, and the newest item's time.",
        "type": "object",
        "required": [
          "id",
          "name",
          "remote",
          "aliases",
          "created",
          "items",
          "current",
          "checkouts",
          "subdir",
          "worktree",
          "roadmap_status",
          "paused",
          "cloud",
          "device",
          "device_by",
          "cloud_secrets",
          "cloud_secrets_by",
          "runner",
          "milestone",
          "milestones_done",
          "milestones_total",
          "plan_slug",
          "plan_ticked",
          "plan_total",
          "last_activity",
          "handoff_at",
          "has_research",
          "has_research_summary",
          "has_spec"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created": {
            "type": "string"
          },
          "items": {
            "type": "integer"
          },
          "current": {
            "type": "boolean"
          },
          "checkouts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subdir": {
            "description": "Where a child project lives under its root's checkout, `/`-separated; null for a root project.",
            "type": [
              "string",
              "null"
            ]
          },
          "worktree": {
            "description": "The linked worktree recorded with `mem project worktree` on this machine, while it is on disk; also the first of `checkouts`.",
            "type": [
              "string",
              "null"
            ]
          },
          "roadmap_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "paused": {
            "description": "\"<rfc3339 UTC> by <who>\" while the project is paused with `mem project set paused <who>`.",
            "type": [
              "string",
              "null"
            ]
          },
          "device": {
            "description": "The device recorded with `mem project set device`: mac-mini-m2, nuc or macbook-m2; null when none is.",
            "type": [
              "string",
              "null"
            ]
          },
          "device_by": {
            "description": "The machine that wrote `device`; null when no device is set.",
            "type": [
              "string",
              "null"
            ]
          },
          "cloud_secrets": {
            "description": "The pass entries `device with-secrets` hands a cloud command, one `NAME=<pass entry>` a line; null when none are set.",
            "type": [
              "string",
              "null"
            ]
          },
          "cloud_secrets_by": {
            "description": "The machine that wrote `cloud_secrets`; null when none are set.",
            "type": [
              "string",
              "null"
            ]
          },
          "cloud": {
            "description": "The machine whose local hub carries the project's milestones to the cloud, set with `mem project set cloud <machine>`; null when none does.",
            "type": [
              "string",
              "null"
            ]
          },
          "runner": {
            "description": "The machine and amx id of this project's orchestrator, from `mem project set runner`; null when none is recorded or the roadmap is done.",
            "type": [
              "object",
              "null"
            ],
            "required": [
              "machine",
              "id",
              "since",
              "first",
              "earlier",
              "milestone",
              "account"
            ],
            "additionalProperties": false,
            "properties": {
              "machine": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "first": {
                "description": "The run's first start: a cloud session that records its own milestone again keeps it, while since moves on.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "earlier": {
                "description": "The cloud sessions that ran this milestone before the one recorded, oldest first; empty for a device's runner.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "milestone": {
                "description": "The milestone a cloud run (machine `cloud`, its session id) works on; null for a device's runner.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "account": {
                "description": "The claude.ai account a cloud run's Project runs on, from its environment's WORKFLOW_ACCOUNT; null when none was recorded, and for a device's runner.",
                "enum": [
                  "work",
                  "main",
                  null
                ]
              }
            }
          },
          "milestone": {
            "type": [
              "string",
              "null"
            ]
          },
          "milestones_done": {
            "type": "integer"
          },
          "milestones_total": {
            "type": "integer"
          },
          "plan_slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan_ticked": {
            "type": "integer"
          },
          "plan_total": {
            "type": "integer"
          },
          "last_activity": {
            "type": [
              "string",
              "null"
            ]
          },
          "handoff_at": {
            "description": "When the latest handoff was written, RFC 3339; null when there is none.",
            "type": [
              "string",
              "null"
            ]
          },
          "has_research": {
            "type": "boolean"
          },
          "has_research_summary": {
            "type": "boolean"
          },
          "has_spec": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
