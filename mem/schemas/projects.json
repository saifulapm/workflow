{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem projects --json",
  "description": "Every project in the store, with this machine's current one marked.",
  "type": "object",
  "required": [
    "projects"
  ],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "project",
        "description": "One registered project.",
        "type": "object",
        "required": [
          "id",
          "name",
          "remote",
          "aliases",
          "created",
          "items",
          "current"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created": {
            "type": "string"
          },
          "items": {
            "type": "integer"
          },
          "current": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
