{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "mem context || true"
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "if workflow guard --help 2>/dev/null | grep -q 'possible values:.*bash'; then workflow guard bash; fi"
        }
      ]
    }
  ],
  "PostToolBatch": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "mem context --brief --hook-json --session-id \"$CLAUDE_CODE_SESSION_ID\" || true"
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "mem precompact --hook-json || true"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "mem stop-hook --session-id \"$CLAUDE_CODE_SESSION_ID\" || true"
        }
      ]
    }
  ]
}
